#!/usr/bin/env bash
# Verify the structurally checkable Acceptance items of issue #1 (zero-config pipeline).
# Prints one PASS/FAIL line per check and exits 1 when any check fails.
set -euo pipefail

pack="$(git rev-parse --show-toplevel)"
cd "$pack"
fails=0

check() { # check <description> <command...>
  local desc="$1"; shift
  if "$@" >/dev/null 2>&1; then echo "PASS  $desc"; else echo "FAIL  $desc"; fails=$((fails + 1)); fi
}

has() { grep -qF -- "$1" "$2"; }                 # has <text> <file>
has_all() { local f="$1"; shift; local t; for t in "$@"; do has "$t" "$f" || return 1; done; }
none() { ! grep -rqE -- "$1" "${@:2}"; }         # none <regex> <paths...>

# 1. pipeline skill
p=skills/pipeline
frontmatter_ok() { has "user-invocable: false" $p/SKILL.md && has "disable-model-invocation: true" $p/SKILL.md; }
check "pipeline: SKILL.md with hidden frontmatter" frontmatter_ok
check "pipeline: tracker-github.md, tracker-local.md, config.md exist" \
  test -f $p/tracker-github.md -a -f $p/tracker-local.md -a -f $p/config.md
check "pipeline/config.md: defaults, global path, Monorepo section" \
  has_all $p/config.md "branch-owner: agent" "push: finalize" "ux-review: disabled" \
  "~/.config/enterprise-engineering-skills/workflow.md" "## Monorepo"

# 2. setup reduced to SKILL.md, old files gone
only_skill_md() { [[ "$(ls skills/setup)" == "SKILL.md" ]]; }
check "setup: contains only SKILL.md" only_skill_md
no_old_files() { [[ -z "$(find skills \( -name 'workflow.md.template' -o -name 'workflow-presets.md' -o -name 'issue-tracker-*.md' \))" ]]; }
check "skills/: no template, presets or issue-tracker-*.md" no_old_files

# 3. no stale references outside setup
others=$(find skills -mindepth 1 -maxdepth 1 -type d ! -name setup)
# shellcheck disable=SC2086
check "skills/ (excl. setup): no /setup, issue-tracker config path or domain.md" \
  none '/setup|docs/agents/config/issue-tracker|domain\.md' $others

# 4. stale model claims
check "pack: no '/implement (Opus)' or 'orchestrating skills run on Opus'" \
  none '/implement \(Opus\)|orchestrating skills run on Opus' skills agents README.md generated agents.toml

# 5. config-reading skills point at the pipeline
refs_pipeline() { grep -rqE 'pipeline/config\.md|\{skills-root\}/pipeline/' "$1"; }
for s in analyze analyze-modify implement verify code-review ux-review complete monorepo-update; do
  check "skills/$s/SKILL.md references pipeline/config.md" refs_pipeline skills/$s/SKILL.md
done

# 6. README
quick_start_no_setup() { ! sed -n '/^## Quick start/,/^## /p' README.md | grep -qE 'run `?/setup`? once'; }
check "README: Quick start has no mandatory /setup" quick_start_no_setup
check "README: Configuration documents defaults and global file" \
  has_all README.md "branch-owner: agent" "push: finalize" "ux-review: disabled" \
  "~/.config/enterprise-engineering-skills/workflow.md"
check "README: no 'Preset' and no 'Both'" none 'Preset|Both' README.md

# 7. install.sh links pipeline into both skill roots
dry_run_lists_pipeline() {
  local home out; home="$(mktemp -d)"
  out="$(HOME="$home" ./install.sh --dry-run 2>&1)"; rm -rf "$home"
  grep -qE '/\.claude/skills/pipeline( |$)' <<<"$out" && grep -qE '/\.agents/skills/pipeline( |$)' <<<"$out"
}
check "install.sh --dry-run lists pipeline for ~/.claude and ~/.agents skills" dry_run_lists_pipeline

echo
if (( fails )); then echo "$fails check(s) failed"; exit 1; fi
echo "all checks passed"
