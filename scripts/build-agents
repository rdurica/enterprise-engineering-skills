#!/usr/bin/env python3
"""Build provider agents from agents/<name>.md (description, instructions) and agents.toml (settings).

Writes generated/claude/agents/<name>.md, generated/codex/agents/<name>.toml and
generated/cursor/agents/<name>.md. With --check, writes nothing and exits 1 when generated/ is stale.
"""
import json
import re
import sys
import tomllib
from pathlib import Path

pack = Path(__file__).resolve().parent.parent
outputs = {
    "claude": ("agents", ".md"),
    "codex": ("agents", ".toml"),
    "cursor": ("agents", ".md"),
}


def q(value):
    return json.dumps(value, ensure_ascii=False)


def read_agent(path):
    """Return (name, description, instructions) from an agent Markdown file."""
    _, front, body = path.read_text(encoding="utf-8").split("---\n", 2)
    meta, key = {}, None
    for line in front.splitlines():
        m = re.match(r"^([a-z_-]+):\s*(.*)$", line)
        if m:
            key, value = m.groups()
            meta[key] = "" if value in (">-", ">", "|") else value.strip()
        elif key and line.startswith("  "):
            meta[key] = f"{meta[key]} {line.strip()}".strip()
    return meta["name"], meta["description"], body.strip()


def read_first(skills, instructions):
    if not skills:
        return instructions
    names = ", ".join(f"`{s}`" for s in skills)
    return f"Before you start, read the {names} skill{'s' if len(skills) > 1 else ''}.\n\n{instructions}"


def header(name):
    return f"# Generated by scripts/build-agents from agents/{name}.md and agents.toml; do not edit."


def render_claude(name, description, instructions, shared, cfg):
    out = ["---", header(name), f"name: {name}", f"description: {q(description)}"]
    if "tools" in cfg:
        out.append(f"tools: {', '.join(cfg['tools'])}")
    for key in ("model", "effort"):
        if key in cfg:
            out.append(f"{key}: {cfg[key]}")
    if shared.get("skills"):
        out.append("skills:")
        out += [f"  - {s}" for s in shared["skills"]]
    if "color" in cfg:
        out.append(f"color: {cfg['color']}")
    return "\n".join(out + ["---", "", instructions]) + "\n"


def render_codex(name, description, instructions, shared, cfg):
    instructions = read_first(shared.get("skills"), instructions)
    # TOML literal multi-line string: no escapes, only ''' is forbidden.
    if "'''" in instructions:
        sys.exit(f"agents/{name}.md: ''' cannot appear in a Codex agent")
    out = [header(name), f"name = {q(name)}", f"description = {q(description)}"]
    if "model" in cfg:
        out.append(f"model = {q(cfg['model'])}")
    if "effort" in cfg:
        out.append(f"model_reasoning_effort = {q(cfg['effort'])}")
    out.append(f"developer_instructions = '''\n{instructions}\n'''")
    return "\n".join(out) + "\n"


def render_cursor(name, description, instructions, shared, cfg):
    out = ["---", header(name), f"name: {name}", f"description: {q(description)}"]
    out.append(f"model: {cfg.get('model', 'inherit')}")
    if shared.get("readonly"):
        out.append("readonly: true")
    out += ["---", "", read_first(shared.get("skills"), instructions)]
    return "\n".join(out) + "\n"


renderers = {"claude": render_claude, "codex": render_codex, "cursor": render_cursor}


def build():
    settings = tomllib.loads((pack / "agents.toml").read_text(encoding="utf-8"))
    sources = {p.stem: p for p in sorted((pack / "agents").glob("*.md"))}
    if missing := sorted(set(sources) - set(settings)):
        sys.exit(f"agents.toml has no settings for: {', '.join(missing)}")
    if unknown := sorted(set(settings) - set(sources)):
        sys.exit(f"agents.toml has settings for missing agents: {', '.join(unknown)}")

    files = {}
    for stem, path in sources.items():
        name, description, instructions = read_agent(path)
        shared = {k: v for k, v in settings[stem].items() if k not in renderers}
        for provider, render in renderers.items():
            if provider in settings[stem]:
                subdir, ext = outputs[provider]
                target = pack / "generated" / provider / subdir / f"{name}{ext}"
                files[target] = render(name, description, instructions, shared, settings[stem][provider])
    return files


def main():
    check = sys.argv[1:] == ["--check"]
    files = build()
    existing = {p for provider in outputs for p in (pack / "generated" / provider).glob("**/*") if p.is_file()}
    stale = [p for p, text in files.items() if not p.is_file() or p.read_text(encoding="utf-8") != text]
    extra = sorted(existing - set(files))

    if check:
        for p in stale + extra:
            print(f"stale   {p.relative_to(pack)}")
        if stale or extra:
            sys.exit("generated/ is out of date; run scripts/build-agents")
        return

    for p in stale:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(files[p], encoding="utf-8")
        print(f"write   {p.relative_to(pack)}")
    for p in extra:
        p.unlink()
        print(f"remove  {p.relative_to(pack)}")


if __name__ == "__main__":
    main()
