#!/usr/bin/env python3
"""Build provider agents from agents/<name>.md (description, instructions) and agents.toml (settings).

Writes generated/claude/agents/<name>.md, generated/codex/agents/<name>.toml,
generated/cursor/agents/<name>.md, generated/opencode/agents/<name>.md and generated/pi/agents/<name>.md.
generated/ is local, gitignored build output: pack defaults overlaid with the user's settings.json
(see scripts/ees_settings.py). With --validate, checks only the sources (agents/ against agents.toml,
defaults against config/models.toml), ignores settings and generated/, and writes nothing.
"""
import json
import re
import sys
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import ees_settings  # noqa: E402

pack = Path(__file__).resolve().parent.parent
outputs = {
    "claude": ("agents", ".md"),
    "codex": ("agents", ".toml"),
    "cursor": ("agents", ".md"),
    "opencode": ("agents", ".md"),
    "pi": ("agents", ".md"),
}


def q(value):
    return json.dumps(value, ensure_ascii=False)


def read_agent(path):
    """Return (name, description, instructions) from an agent Markdown file."""
    _, front, body = path.read_text(encoding="utf-8").split("---\n", 2)
    meta, key = {}, None
    for line in front.splitlines():
        m = re.match(r"^([a-z_-]+):\s*(.*)$", line)
        if m:
            key, value = m.groups()
            meta[key] = "" if value in (">-", ">", "|") else value.strip()
        elif key and line.startswith("  "):
            meta[key] = f"{meta[key]} {line.strip()}".strip()
    return meta["name"], meta["description"], body.strip()


def read_first(skills, instructions):
    if not skills:
        return instructions
    names = ", ".join(f"`{s}`" for s in skills)
    return f"Before you start, read the {names} skill{'s' if len(skills) > 1 else ''}.\n\n{instructions}"


def header(name):
    return f"# Generated by scripts/build-agents from agents/{name}.md and agents.toml; do not edit."


def render_claude(name, description, instructions, shared, cfg):
    out = ["---", header(name), f"name: {name}", f"description: {q(description)}"]
    if "tools" in cfg:
        out.append(f"tools: {', '.join(cfg['tools'])}")
    for key in ("model", "effort"):
        if key in cfg:
            out.append(f"{key}: {cfg[key]}")
    if shared.get("skills"):
        out.append("skills:")
        out += [f"  - {s}" for s in shared["skills"]]
    if "color" in cfg:
        out.append(f"color: {cfg['color']}")
    return "\n".join(out + ["---", "", instructions]) + "\n"


def render_codex(name, description, instructions, shared, cfg):
    instructions = read_first(shared.get("skills"), instructions)
    # TOML literal multi-line string: no escapes, only ''' is forbidden.
    if "'''" in instructions:
        sys.exit(f"agents/{name}.md: ''' cannot appear in a Codex agent")
    out = [header(name), f"name = {q(name)}", f"description = {q(description)}"]
    if "model" in cfg:
        out.append(f"model = {q(cfg['model'])}")
    if "effort" in cfg:
        out.append(f"model_reasoning_effort = {q(cfg['effort'])}")
    out.append(f"developer_instructions = '''\n{instructions}\n'''")
    return "\n".join(out) + "\n"


def render_cursor(name, description, instructions, shared, cfg):
    out = ["---", header(name), f"name: {name}", f"description: {q(description)}"]
    out.append(f"model: {cfg.get('model', 'inherit')}")
    if shared.get("readonly"):
        out.append("readonly: true")
    out += ["---", "", read_first(shared.get("skills"), instructions)]
    return "\n".join(out) + "\n"


def render_opencode(name, description, instructions, shared, cfg):
    # opencode names the agent after its file, so no name key.
    out = ["---", header(name), f"description: {q(description)}", "mode: subagent"]
    for key in ("model", "variant"):
        if key in cfg:
            out.append(f"{key}: {cfg[key]}")
    if shared.get("readonly"):
        out += ["permission:", "  edit: deny"]
    out += ["---", "", read_first(shared.get("skills"), instructions)]
    return "\n".join(out) + "\n"


def render_pi(name, description, instructions, shared, cfg):
    out = ["---", header(name), f"name: {name}", f"description: {q(description)}"]
    # Pi takes the thinking level as a suffix of --model, which is how `variant` reaches the agent.
    if "model" in cfg:
        out.append(f"model: {cfg['model']}:{cfg['variant']}" if cfg.get("variant") else f"model: {cfg['model']}")
    # Pi has read, bash, edit and write; a read-only agent keeps read and bash (tests, git).
    tools = cfg.get("tools") or (["read", "bash"] if shared.get("readonly") else None)
    if tools:
        out.append(f"tools: {', '.join(tools)}")
    out += ["---", "", read_first(shared.get("skills"), instructions)]
    return "\n".join(out) + "\n"


renderers = {
    "claude": render_claude,
    "codex": render_codex,
    "cursor": render_cursor,
    "opencode": render_opencode,
    "pi": render_pi,
}


def check_sources():
    """Return (agents.toml, catalog, sources); exit on a mismatch between agents/ and agents.toml or a default outside the catalog."""
    settings = tomllib.loads((pack / "agents.toml").read_text(encoding="utf-8"))
    sources = {p.stem: p for p in sorted((pack / "agents").glob("*.md"))}
    if missing := sorted(set(sources) - set(settings)):
        sys.exit(f"agents.toml has no settings for: {', '.join(missing)}")
    if unknown := sorted(set(settings) - set(sources)):
        sys.exit(f"agents.toml has settings for missing agents: {', '.join(unknown)}")
    catalog = ees_settings.load_catalog(pack)
    if errors := ees_settings.check_defaults(settings, catalog):
        sys.exit("\n".join(errors))
    return settings, catalog, sources


def build():
    defaults, catalog, sources = check_sources()
    user, problems = ees_settings.load_settings()
    problems += ees_settings.check_top_level(user, catalog)
    settings, more = ees_settings.merge_agents(defaults, user, catalog)
    for problem in problems + more:
        ees_settings.warn(problem)

    files = {}
    for stem, path in sources.items():
        name, description, instructions = read_agent(path)
        shared = {k: v for k, v in settings[stem].items() if k not in renderers}
        for provider, render in renderers.items():
            if provider in settings[stem]:
                subdir, ext = outputs[provider]
                target = pack / "generated" / provider / subdir / f"{name}{ext}"
                files[target] = render(name, description, instructions, shared, settings[stem][provider])
    return files


def main():
    args = sys.argv[1:]
    if args == ["--validate"]:
        check_sources()
        return
    if args:
        sys.exit("usage: scripts/build-agents [--validate]")
    files = build()
    # Only the agents directory: generated/<provider>/ may hold other outputs (Pi slash commands).
    existing = {
        p
        for provider, (subdir, _) in outputs.items()
        for p in (pack / "generated" / provider / subdir).glob("*")
        if p.is_file()
    }
    stale = [p for p, text in files.items() if not p.is_file() or p.read_text(encoding="utf-8") != text]
    extra = sorted(existing - set(files))

    for p in stale:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(files[p], encoding="utf-8")
        print(f"write   {p.relative_to(pack)}")
    for p in extra:
        p.unlink()
        print(f"remove  {p.relative_to(pack)}")


if __name__ == "__main__":
    main()
