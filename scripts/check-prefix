#!/usr/bin/env bash
# Verify the prefix guard of issue #5: every installed skill and agent carries the `ees-` prefix in
# its directory, frontmatter, agents.toml, generated files and references, and install.sh links only
# prefixed names. The pack root comes from this script's location, never from git, so the guard also
# runs on a copied tree. Prints one PASS/FAIL line per check and exits 1 when any check fails.
#
# The self-test copies the tree (without .git), adds skills/foo and a [foo] table, and expects the
# copied guard to fail. CHECK_PREFIX_NO_SELF_TEST=1 skips that copy so it does not recurse.
set -euo pipefail
shopt -s nullglob

pack="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$pack"
fails=0

check() { # check <description> <command...>
  local desc="$1"; shift
  local out
  if out="$("$@" 2>&1)"; then
    echo "PASS  $desc"
  else
    echo "FAIL  $desc"
    fails=$((fails + 1))
    [[ -n "$out" ]] && awk 'NR <= 20 { print "      " $0 }' <<<"$out"
  fi
}

prefix="ees-"
skill_names=(analyze analyze-modify change code-review commit complete discuss git-release idea \
  implement integration-tests monorepo-update pipeline setup tdd ux-review verify)
agent_names=(check-runner code-reviewer functional-reviewer implementer test-writer ux-reviewer)

declare -A want_skill=() want_agent=()
for n in "${skill_names[@]}"; do want_skill["$prefix$n"]=1; done
for n in "${agent_names[@]}"; do want_agent["$prefix$n"]=1; done

# ---------------------------------------------------------------- skills/

skills_prefixed() { # every directory except personal/ carries the prefix
  local d base bad=0
  for d in skills/*/; do
    base="${d%/}"; base="${base#skills/}"
    [[ "$base" == personal ]] && continue
    if [[ "$base" != "$prefix"* ]]; then
      echo "unprefixed skill directory: skills/$base"
      bad=1
    fi
  done
  return "$bad"
}

skills_exact() { # exactly the 17 expected ees-* directories, nothing else
  local d base bad=0
  declare -A actual=()
  for d in skills/*/; do
    base="${d%/}"; base="${base#skills/}"
    [[ "$base" == personal ]] && continue
    actual["$base"]=1
  done
  for base in "${!want_skill[@]}"; do
    [[ -d "skills/$base" ]] || { echo "missing skill directory: skills/$base"; bad=1; }
  done
  for base in "${!actual[@]}"; do
    [[ -n "${want_skill[$base]:-}" ]] || { echo "unexpected skill directory: skills/$base"; bad=1; }
  done
  [[ ${#actual[@]} -eq ${#skill_names[@]} ]] ||
    { echo "expected ${#skill_names[@]} skill directories, found ${#actual[@]}"; bad=1; }
  return "$bad"
}

skills_frontmatter() { # each SKILL.md name: equals its directory name
  local d base name bad=0
  for d in skills/*/; do
    base="${d%/}"; base="${base#skills/}"
    [[ "$base" == personal ]] && continue
    if [[ ! -f "$d/SKILL.md" ]]; then
      echo "missing SKILL.md: ${d}SKILL.md"
      bad=1
      continue
    fi
    name="$(sed -n 's/^name:[[:space:]]*//p' "$d/SKILL.md" | head -1 | sed 's/[[:space:]]*$//')"
    [[ "$name" == "$base" ]] ||
      { echo "name '$name' does not match directory '$base': ${d}SKILL.md"; bad=1; }
  done
  return "$bad"
}

# ---------------------------------------------------------------- agents/

agents_prefixed() { # exactly six ees-*.md files with the expected names
  local f base bad=0
  declare -A actual=()
  for f in agents/*.md; do
    base="$(basename "$f" .md)"
    actual["$base"]=1
    if [[ "$base" != "$prefix"* ]]; then
      echo "unprefixed agent file: $f"
      bad=1
    fi
  done
  for base in "${!want_agent[@]}"; do
    [[ -f "agents/$base.md" ]] || { echo "missing agent file: agents/$base.md"; bad=1; }
  done
  for base in "${!actual[@]}"; do
    [[ -n "${want_agent[$base]:-}" ]] || { echo "unexpected agent file: agents/$base.md"; bad=1; }
  done
  [[ ${#actual[@]} -eq ${#agent_names[@]} ]] ||
    { echo "expected ${#agent_names[@]} agent files, found ${#actual[@]}"; bad=1; }
  return "$bad"
}

agents_frontmatter() { # each name: equals its file name
  local f base name bad=0
  for f in agents/*.md; do
    base="$(basename "$f" .md)"
    name="$(sed -n 's/^name:[[:space:]]*//p' "$f" | head -1 | sed 's/[[:space:]]*$//')"
    [[ "$name" == "$base" ]] || { echo "name '$name' does not match file '$base': $f"; bad=1; }
  done
  return "$bad"
}

toml_keys() { # every table key is prefixed and matches exactly one agent file
  local key base f bad=0
  declare -A keys=() files=()
  while IFS= read -r key; do
    keys["$key"]=1
    [[ "$key" == "$prefix"* ]] || { echo "unprefixed agents.toml key: [$key]"; bad=1; }
  done < <(grep -E '^\[[^][]+\]$' agents.toml | sed -E 's/^\[(.*)\]$/\1/')
  for f in agents/*.md; do base="$(basename "$f" .md)"; files["$base"]=1; done
  for key in "${!keys[@]}"; do
    [[ -n "${files[$key]:-}" ]] || { echo "agents.toml key [$key] has no agents/$key.md"; bad=1; }
  done
  for base in "${!files[@]}"; do
    [[ -n "${keys[$base]:-}" ]] || { echo "agents/$base.md has no agents.toml table [$base]"; bad=1; }
  done
  return "$bad"
}

toml_skills() { # every skills = [...] entry is a prefixed, existing skill directory
  local line entry bad=0
  while IFS= read -r line; do
    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue
      if [[ "$entry" != "$prefix"* ]]; then
        echo "unprefixed skills entry in agents.toml: $entry"
        bad=1
      elif [[ ! -d "skills/$entry" ]]; then
        echo "agents.toml skills entry names no skill directory: skills/$entry"
        bad=1
      fi
    done < <(grep -oE '"[^"]+"' <<<"$line" | tr -d '"')
  done < <(grep -E '^[[:space:]]*skills[[:space:]]*=' agents.toml)
  return "$bad"
}

# ---------------------------------------------------------------- generated/

generated_prefixed() { # all four providers have agents/ with only ees-* files
  local prov dir f base bad=0
  for prov in claude codex cursor opencode; do
    [[ -d "generated/$prov/agents" ]] ||
      { echo "missing directory: generated/$prov/agents"; bad=1; }
  done
  for dir in generated/*/agents; do
    for f in "$dir"/*; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      [[ "$base" == "$prefix"* ]] || { echo "unprefixed generated file: $f"; bad=1; }
    done
  done
  return "$bad"
}

# ---------------------------------------------------------------- unprefixed references

# Files scanned for leftover unprefixed identifiers: README, skills, agents and the existing check
# scripts. scripts/check-prefix is the guard itself (its name lists are data, not references).
scan_files() {
  find README.md skills agents -type f -print
  find scripts -maxdepth 1 -type f -name 'check-*' ! -name 'check-prefix' -print
}

# ident_ere <alternation of unprefixed names>: the identifier shapes /name, @name, skills/name,
# {skills-root}/name, agents/name.md and ../name/. Ordinary words in prose do not match.
ident_ere() {
  local a="$1"
  printf '%s' \
    "(^|[^A-Za-z0-9_./-])/($a)([^A-Za-z0-9_-]|$)" \
    "|(^|[^A-Za-z0-9_-])@($a)([^A-Za-z0-9_-]|$)" \
    "|(^|[^A-Za-z0-9_-])skills/($a)([^A-Za-z0-9_-]|$)" \
    "|\\{skills-root\\}/($a)([^A-Za-z0-9_-]|$)" \
    "|(^|[^A-Za-z0-9_-])agents/($a)\\.md([^A-Za-z0-9_-]|$)" \
    "|\\.\\./($a)/"
}

unprefixed_refs() { # unprefixed_refs <alternation>; prints offending file:line:text
  local ere="$1" hits
  local -a files=()
  mapfile -t files < <(scan_files)
  [[ ${#files[@]} -gt 0 ]] || { echo "no files to scan"; return 1; }
  hits="$(grep -nHE -- "$ere" "${files[@]}" 2>/dev/null || true)"
  [[ -z "$hits" ]] && return 0
  awk 'NR <= 20' <<<"$hits"
  return 1
}

skills_refs() { unprefixed_refs "$(ident_ere "$(printf '%s|' "${skill_names[@]}" | sed 's/|$//')")"; }
agents_refs() { unprefixed_refs "$(ident_ere "$(printf '%s|' "${agent_names[@]}" | sed 's/|$//')")"; }

docs_not_prefixed_docs() { # docs/ees does not exist, in content or as a path
  local needle="docs/ees" hits bad=0
  local -a files=()
  [[ -e "$needle" ]] && { echo "path exists: $needle"; bad=1; }
  mapfile -t files < <(find README.md skills agents scripts generated config agents.toml install.sh .githooks \
    -type f ! -path 'scripts/check-prefix' -print)
  if [[ ${#files[@]} -gt 0 ]]; then
    hits="$(grep -nHF -- "$needle" "${files[@]}" 2>/dev/null || true)"
    if [[ -n "$hits" ]]; then
      awk 'NR <= 20' <<<"$hits"
      bad=1
    fi
  fi
  return "$bad"
}

# ---------------------------------------------------------------- install.sh --dry-run

sandbox="$(mktemp -d)"
cleanup() { rm -rf "$sandbox"; }
trap cleanup EXIT

install_names() { # link/relink/ok lines for skills and agents name only ees-*
  local home="$sandbox/home" claude="$sandbox/claude" xdg="$sandbox/xdg" codex="$sandbox/codex"
  mkdir -p "$home" "$claude" "$xdg" "$codex" "$sandbox/data" "$sandbox/cache" "$sandbox/state"
  local out rc=0 line action dest base bad=0 skills=0 agents=0
  out="$(HOME="$home" XDG_CONFIG_HOME="$xdg" XDG_DATA_HOME="$sandbox/data" \
    XDG_CACHE_HOME="$sandbox/cache" XDG_STATE_HOME="$sandbox/state" \
    CLAUDE_CONFIG_DIR="$claude" CODEX_HOME="$codex" "$pack/install.sh" --dry-run 2>&1)" || rc=$?
  if (( rc != 0 )); then
    echo "install.sh --dry-run exited with $rc"
    awk 'NR <= 10' <<<"$out"
    return 1
  fi
  while IFS= read -r line; do
    read -r action dest _ <<<"$line"
    case "$action" in
      link|relink|ok) ;;
      *) continue ;;
    esac
    [[ -n "${dest:-}" ]] || continue
    if [[ "$dest" == */skills/* ]]; then
      skills=$((skills + 1))
      base="$(basename "$dest")"
      [[ "$base" == "$prefix"* ]] || { echo "$action names an unprefixed skill: $dest"; bad=1; }
    elif [[ "$dest" == */agents/* ]]; then
      agents=$((agents + 1))
      base="$(basename "$dest")"
      [[ "$base" == "$prefix"* ]] || { echo "$action names an unprefixed agent: $dest"; bad=1; }
    fi
  done <<<"$out"
  (( skills > 0 )) || { echo "install.sh --dry-run printed no skill link/relink/ok line"; bad=1; }
  (( agents > 0 )) || { echo "install.sh --dry-run printed no agent link/relink/ok line"; bad=1; }
  return "$bad"
}

# ---------------------------------------------------------------- negative self-test

copy_tree() { mkdir -p "$1" && (cd "$pack" && tar --exclude=./.git -cf - .) | tar -xf - -C "$1"; }

self_test() { # a copy with skills/foo and a [foo] table must fail the copied guard
  local tmp out rc=0
  tmp="$(mktemp -d)"
  copy_tree "$tmp"
  mkdir -p "$tmp/skills/foo"
  printf '%s\n' '---' 'name: foo' '---' '' >"$tmp/skills/foo/SKILL.md"
  printf '\n[foo]\n' >>"$tmp/agents.toml"
  out="$(CHECK_PREFIX_NO_SELF_TEST=1 "$tmp/scripts/check-prefix" 2>&1)" || rc=$?
  rm -rf "$tmp"
  if (( rc == 0 )); then
    echo "the copied check-prefix accepted skills/foo and a [foo] table"
    return 1
  fi
  grep -qF 'skills/foo' <<<"$out" || {
    echo "the copied check-prefix failed, but did not report skills/foo"
    awk 'NR <= 20' <<<"$out"
    return 1
  }
  grep -qF '[foo]' <<<"$out" || {
    echo "the copied check-prefix failed, but did not report the [foo] table"
    awk 'NR <= 20' <<<"$out"
    return 1
  }
}

# ---------------------------------------------------------------- checks

check "skills/: every directory except personal/ has the ees- prefix" skills_prefixed
check "skills/: exactly the 17 expected ees-* directories" skills_exact
check "skills/: each SKILL.md name matches its directory" skills_frontmatter
check "agents/: exactly six ees-*.md files and no other agent files" agents_prefixed
check "agents/: each frontmatter name matches its file" agents_frontmatter
check "agents.toml: prefixed keys match the agent files exactly" toml_keys
check "agents.toml: every skills entry names an existing prefixed skill" toml_skills
check "generated/: every provider has agents/ with only ees-* files" generated_prefixed
check "generated/: scripts/build-agents --check is green" "$pack/scripts/build-agents" --check
check "docs: no unprefixed skill identifiers in README, skills, agents, scripts/check-*" skills_refs
check "docs: no unprefixed agent identifiers in README, skills, agents, scripts/check-*" agents_refs
check "docs: no docs/ees path or reference" docs_not_prefixed_docs
check "install.sh --dry-run: skill and agent lines name only ees-*" install_names
if [[ "${CHECK_PREFIX_NO_SELF_TEST:-0}" == 1 ]]; then
  echo "SKIP  self-test: disabled by CHECK_PREFIX_NO_SELF_TEST"
else
  check "self-test: a copy with skills/foo and [foo] fails" self_test
fi

echo
if (( fails )); then echo "$fails check(s) failed"; exit 1; fi
echo "all checks passed"
