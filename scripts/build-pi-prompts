#!/usr/bin/env python3
"""Build Pi slash commands for the pack's skills: generated/pi/prompts/<skill>.md.

Pi exposes skills as `/skill:<name>`, while every skill and document in this pack spells them
`/ees-<name>`. Pi prompt templates turn a Markdown file into a `/` command, so one small template per
skill makes the documented spelling work without duplicating the instructions: the template points the
model at the skill's SKILL.md, which install.sh links into ~/.agents/skills/.

Pi has no per-skill model, so a skill runs on the session model. With --check, writes nothing and
exits 1 when generated/pi/prompts is stale.
"""
import json
import re
import sys
from pathlib import Path

pack = Path(__file__).resolve().parent.parent
target_dir = pack / "generated" / "pi" / "prompts"
skills_link_dir = "~/.agents/skills"


def q(value):
    return json.dumps(value, ensure_ascii=False)


def read_frontmatter(path):
    """Return the frontmatter of a SKILL.md as a dict, folding `>-` blocks onto one line."""
    _, front, _ = path.read_text(encoding="utf-8").split("---\n", 2)
    meta, key = {}, None
    for line in front.splitlines():
        m = re.match(r"^([a-z_-]+):\s*(.*)$", line)
        if m:
            key, value = m.groups()
            meta[key] = "" if value in (">-", ">", "|") else value.strip()
        elif key and line.startswith("  "):
            meta[key] = f"{meta[key]} {line.strip()}".strip()
    # `argument-hint: "[push]"` keeps the quotes; they are YAML syntax, not part of the value.
    return {k: v[1:-1] if len(v) > 1 and v[0] == v[-1] and v[0] in "\"'" else v for k, v in meta.items()}


def render(name, description, argument_hint):
    out = ["---", f"# Generated by scripts/build-pi-prompts from skills/{name}/SKILL.md; do not edit."]
    out.append(f"description: {q(description)}")
    if argument_hint:
        out.append(f"argument-hint: {q(argument_hint)}")
    out += [
        "---",
        "",
        f"Load the `{name}` skill from `{skills_link_dir}/{name}/SKILL.md` and follow it exactly.",
        "That directory also holds its references and scripts.",
        "",
        "Arguments: ${@:-none}",
    ]
    return "\n".join(out) + "\n"


def build():
    files = {}
    for path in sorted((pack / "skills").glob("*/SKILL.md")):
        meta = read_frontmatter(path)
        name = meta.get("name") or path.parent.name
        # A library skill with no user-facing entry point gets no command.
        if meta.get("user-invocable") == "false":
            continue
        if not meta.get("description"):
            sys.exit(f"skills/{path.parent.name}/SKILL.md: no description")
        files[target_dir / f"{name}.md"] = render(name, meta["description"], meta.get("argument-hint"))
    return files


def main():
    check = sys.argv[1:] == ["--check"]
    files = build()
    existing = {p for p in target_dir.glob("*.md")} if target_dir.is_dir() else set()
    stale = [p for p, text in files.items() if not p.is_file() or p.read_text(encoding="utf-8") != text]
    extra = sorted(existing - set(files))

    if check:
        for p in stale + extra:
            print(f"stale   {p.relative_to(pack)}")
        if stale or extra:
            sys.exit("generated/pi/prompts is out of date; run scripts/build-pi-prompts")
        return

    for p in stale:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(files[p], encoding="utf-8")
        print(f"write   {p.relative_to(pack)}")
    for p in extra:
        p.unlink()
        print(f"remove  {p.relative_to(pack)}")


if __name__ == "__main__":
    main()
