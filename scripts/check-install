# ---------------------------------------------------------------- [11] wizard defaults on a terminal

# A provider is preselected only when it is already linked into this pack. A fake codex CLI makes
# Codex "installed" (is_present) without any pack link, so it must stay unselected.
c11a="$(scenario pty-linked)"
mkdir -p "$c11a/claude/agents"
ln -s "$tree/generated/claude/agents/ees-test-writer.md" "$c11a/claude/agents/ees-test-writer.md"
printf '#!/usr/bin/env bash\nexit 0\n' >"$c11a/bin/codex"
chmod +x "$c11a/bin/codex"
printf '\n\n' >"$c11a/stdin"
run_pty "$c11a"
wizard_preselects() { # wizard_preselects <out> <provider-number>: the picker marks provider N [x]
  grep -qE "^[[:space:]]*$2\) .*\[x\]" "$1"
}
wizard_does_not_preselect() { # wizard_does_not_preselect <out> <provider-number>
  ! wizard_preselects "$1" "$2"
}
pty_defaults_linked_only() {
  local d="$1" p
  has_rc "$d" 0 || return 1
  grep -qF 'Apply this plan?' "$d/out" || { echo "no plan confirmation prompt"; return 1; }
  wizard_preselects "$d/out" 1 || { echo "linked Claude is not preselected"; return 1; }
  wizard_does_not_preselect "$d/out" 2 ||
    { echo "installed-but-unlinked Codex is preselected"; return 1; }
  assert_skill_root "$d/claude/skills" || return 1
  assert_agent_dir "$d" claude || return 1
  assert_no_pack_links "$d/home/.agents/skills" || return 1
  for p in codex cursor opencode pi; do assert_no_pack_links "$(agent_dest "$d" "$p")" || return 1; done
  assert_no_pack_links "$d/pi/agent/prompts" || return 1
  assert_no_extension_link "$d" || return 1
  plan_omits "$d/out" "$d/home/.agents/skills/" "$d/codex/agents/" "$d/home/.cursor/agents/" \
    "$d/xdg/opencode/agents/" "$d/pi/agent/"
}
check "[11] on a terminal the wizard preselects only the linked provider, not an installed one" pty_defaults_linked_only "$c11a"

# The wizard explains the [x] markers and how to select several tools in one answer.
pty_wizard_help() {
  local d="$1"
  grep -qF 'x = preselected' "$d/out" ||
    { echo "wizard heading is missing the preselection legend"; return 1; }
  grep -qF 'numbers separated by commas or spaces' "$d/out" ||
    { echo "wizard is missing the multi-selection hint"; return 1; }
  grep -qF 'press Enter for the default' "$d/out" ||
    { echo "wizard hint does not mention the Enter default"; return 1; }
}
check "[11] the wizard heading and hint explain x = preselected, comma/space numbers and Enter" pty_wizard_help "$c11a"

