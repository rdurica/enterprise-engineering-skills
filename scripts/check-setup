#!/usr/bin/env bash
# Verify the settings, catalog, build and opencode-config parts of issue #12 (setup GUI and user
# deviations). Prints one PASS/FAIL line per check and exits 1 when any check fails.
#
# The checks are black-box: they run scripts/build-agents, scripts/build-pi-prompts and
# scripts/opencode-config the way a user does and look at the files and output they produce. They know
# nothing about the internals of scripts/ees_settings.py.
#
# Every behavioural check builds its own tiny fixture tree (agents/, agents.toml, config/models.toml,
# config/opencode.json, skills/) inside a mktemp sandbox and copies scripts/ into it, so the result does not
# depend on the real catalog. HOME, XDG_CONFIG_HOME, CLAUDE_CONFIG_DIR and CODEX_HOME point into the
# sandbox, so the user's settings.json (<sandbox>/xdg/enterprise-engineering-skills/settings.json) and
# every provider directory are never read or touched. A stub `opencode` on PATH answers `debug agents`
# with an empty list. The [real] checks use a sandboxed copy of the whole pack instead.
#
# Areas are separate functions (area_*), run from main at the bottom. Add the GUI / HTTP API checks of the
# setup server as one more area function and one more line in main.
#
# Labels map to Acceptance items of #12:
#   [A-settings]  settings hold only deviations; an absent key means the pack default
#   [A-codex]     codex model override changes only `model`, not the effort
#   [A-default]   a new pack default reaches agents the user did not override, overrides persist
#   [A-catalog]   a value outside the catalog warns and is still used; a default outside it fails the build
#   [A-validate]  build-agents --validate checks sources only and writes nothing; --check is gone
#   [A-opencode]  opencode deviations land in opencode.json instead of the config/opencode.json default
#   [A-unknown]   unknown agent, provider or key in settings.json warns and is ignored
#   [real]        the real pack: catalog present and every default in it
# Not covered here (writer side, owned by the GUI/HTTP area): identical-to-default not stored and reset
# removing the key; both go through POST /api/save, whose API contract is the public interface.
set -euo pipefail
shopt -s nullglob

pack="$(git rev-parse --show-toplevel)"
cd "$pack"
fails=0

check() { # check <description> <command...>
  local desc="$1"; shift
  local out
  if out="$("$@" 2>&1)"; then
    echo "PASS  $desc"
  else
    echo "FAIL  $desc"
    fails=$((fails + 1))
    if [[ -n "$out" ]]; then
      awk 'NR <= 14 { print "      " $0 }' <<<"$out"
    fi
  fi
}

# ---------------------------------------------------------------- sandbox

sb="$(mktemp -d)"
trap 'rm -rf "$sb"' EXIT

# Stub bin dir in front of PATH: an opencode that reports no agents, so opencode-config never talks to a
# real opencode.
stubbin="$sb/stubbin"
mkdir -p "$stubbin"
cat >"$stubbin/opencode" <<'STUB'
#!/usr/bin/env bash
echo '[]'
STUB
chmod +x "$stubbin/opencode"

counter=0

# in_env <scenario-dir> <command...>: run in the scenario tree with every config location in the sandbox.
in_env() {
  local d="$1"; shift
  (cd "$d/tree" && timeout 120 env HOME="$d/home" XDG_CONFIG_HOME="$d/xdg" CLAUDE_CONFIG_DIR="$d/claude" \
    CODEX_HOME="$d/codex" PATH="$stubbin:$PATH" "$@")
}

# run <scenario-dir> <command...>: combined output in <dir>/out, exit code in <dir>/rc; never fails itself.
run() {
  local d="$1"; shift
  local rc=0
  in_env "$d" "$@" >"$d/out" 2>&1 || rc=$?
  echo "$rc" >"$d/rc"
}

settings_file() { echo "$1/xdg/enterprise-engineering-skills/settings.json"; }

write_settings() { # write_settings <scenario-dir> <json on stdin>
  mkdir -p "$1/xdg/enterprise-engineering-skills"
  cat >"$(settings_file "$1")"
}

# ---------------------------------------------------------------- assertions (each returns 1 with a message)

ran_ok() { # ran_ok <dir>: the last run exited 0
  [[ "$(<"$1/rc")" == 0 ]] && return 0
  echo "expected exit 0, got $(<"$1/rc"); output:"
  cat "$1/out"
  return 1
}

ran_failed() { # ran_failed <dir>: the last run exited non-zero
  [[ "$(<"$1/rc")" != 0 ]] && return 0
  echo "expected a non-zero exit, got 0; output:"
  cat "$1/out"
  return 1
}

has_line() { # has_line <file> <exact line>
  grep -Fxq -- "$2" "$1" && return 0
  echo "missing line in ${1#"$sb"/}: $2"
  return 1
}

lacks_line() { # lacks_line <file> <exact line>
  grep -Fxq -- "$2" "$1" || return 0
  echo "unexpected line in ${1#"$sb"/}: $2"
  return 1
}

# lines_with <file> <regex> <needle>...: lines matching regex that contain every needle.
lines_with() {
  local file="$1" regex="$2" lines needle
  shift 2
  lines="$(grep -E -- "$regex" "$file" || true)"
  for needle in "$@"; do
    lines="$(grep -F -- "$needle" <<<"$lines" || true)"
  done
  printf '%s' "$lines"
}

warned() { # warned <dir> <needle>...: the run printed a `warn` line naming every needle
  [[ -n "$(lines_with "$1/out" '^warn([[:space:]]|:)' "${@:2}")" ]] && return 0
  echo "no 'warn' line naming: ${*:2}; output:"
  cat "$1/out"
  return 1
}

did_not_warn() { # did_not_warn <dir>
  grep -Eq '^warn([[:space:]]|:)' "$1/out" || return 0
  echo "unexpected warn; output:"
  cat "$1/out"
  return 1
}

names() { # names <dir> <needle>...: the output has one line naming every needle (an error message)
  [[ -n "$(lines_with "$1/out" '.' "${@:2}")" ]] && return 0
  echo "no output line naming: ${*:2}; output:"
  cat "$1/out"
  return 1
}

gen_hash() { # gen_hash <dir>: checksum of every file under generated/ (empty when there is none)
  [[ -d "$1/tree/generated" ]] || return 0
  (cd "$1/tree/generated" && find . -type f -print0 | sort -z | xargs -0 sha256sum)
}

json_get() { # json_get <file> <python expr over `c`> -> value (JSON) or the word MISSING
  python3 -I -c '
import json, sys
c = json.load(open(sys.argv[1]))
try:
    print(json.dumps(eval(sys.argv[2])))
except (KeyError, IndexError, TypeError):
    print("MISSING")
' "$1" "$2"
}

json_is() { # json_is <file> <python expr over `c`> <expected JSON>
  local got
  got="$(json_get "$1" "$2")"
  [[ "$got" == "$3" ]] && return 0
  echo "${1#"$sb"/}: $2 is $got, expected $3"
  return 1
}

edit() { # edit <file> <sed expression>: portable sed -i
  sed -i.bak "$2" "$1" && rm -f "$1.bak"
}

# ---------------------------------------------------------------- fixture tree

# new_fx <name>: a fresh scenario dir with a fixture pack in <dir>/tree; prints the dir.
new_fx() {
  counter=$((counter + 1))
  local d="$sb/$counter-$1" t
  t="$d/tree"
  mkdir -p "$d"/{home,xdg,claude,codex} "$t"/{agents,config,scripts,skills/ees-demo}

  local f
  for f in "$pack"/scripts/*; do
    [[ "$(basename "$f")" == check-* ]] && continue
    cp -a "$f" "$t/scripts/"
  done

  local name
  for name in ees-code-reviewer ees-implementer; do
    cat >"$t/agents/$name.md" <<AGENT
---
name: $name
description: Fixture agent $name.
---

Instructions of $name.
AGENT
  done

  cat >"$t/skills/ees-demo/SKILL.md" <<'SKILL'
---
name: ees-demo
description: Fixture skill.
---

Demo.
SKILL

  cat >"$t/agents.toml" <<'TOML'
[ees-code-reviewer]
readonly = true
claude = { model = "opus", effort = "low", tools = ["Read", "Grep"], color = "red" }
codex = { model = "gpt-6.1-terra", effort = "high" }
cursor = { model = "grok-4.7-high" }
opencode = { model = "claude-agent/sonnet", variant = "high" }
pi = { model = "opencode-go/deepseek-v4.1-flash", variant = "high" }

[ees-implementer]
claude = { model = "sonnet", effort = "medium", color = "green" }
codex = { model = "gpt-6.1-terra", effort = "medium" }
opencode = { model = "opencode-go/deepseek-v4.1-flash", variant = "high" }
pi = { model = "opencode-go/deepseek-v4.1-flash", variant = "high" }
TOML

  cat >"$t/config/models.toml" <<'TOML'
[claude]
models  = ["opus", "sonnet", "haiku"]
efforts = ["low", "medium", "high", "xhigh", "max"]

[codex]
models  = ["gpt-6-luna", "gpt-6.1-terra", "gpt-6.2-terra"]
efforts = ["low", "medium", "high", "xhigh"]

[cursor]
models  = ["grok-4.7-low", "grok-4.7-medium", "grok-4.7-high"]

[opencode]
models   = ["claude-agent/opus", "claude-agent/sonnet", "opencode-go/deepseek-v4.1-flash"]
variants = ["low", "medium", "high"]

[pi]
models   = ["opencode-go/deepseek-v4.1-flash"]
variants = ["low", "medium", "high"]
TOML

  cat >"$t/config/opencode.json" <<'JSON'
{
  "model": "claude-agent/opus",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "agent": {
    "build":   { "model": "claude-agent/opus" },
    "general": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" },
    "explore": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "low" }
  }
}
JSON
  echo "$d"
}

gen() { echo "$1/tree/generated/$2"; } # gen <dir> <path under generated/>

codex_reviewer() { gen "$1" codex/agents/ees-code-reviewer.toml; }

# ---------------------------------------------------------------- area: settings overlay in build-agents

c_defaults_without_settings() {
  local d; d="$(new_fx defaults)"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  has_line "$(codex_reviewer "$d")" 'model = "gpt-6.1-terra"' || return 1
  has_line "$(codex_reviewer "$d")" 'model_reasoning_effort = "high"' || return 1
  has_line "$(gen "$d" claude/agents/ees-code-reviewer.md)" 'model: opus' || return 1
  has_line "$(gen "$d" claude/agents/ees-code-reviewer.md)" 'effort: low' || return 1
  has_line "$(gen "$d" opencode/agents/ees-code-reviewer.md)" 'model: claude-agent/sonnet' || return 1
  has_line "$(gen "$d" opencode/agents/ees-code-reviewer.md)" 'variant: high' || return 1
  has_line "$(gen "$d" pi/agents/ees-code-reviewer.md)" 'model: opencode-go/deepseek-v4.1-flash:high' || return 1
  has_line "$(gen "$d" cursor/agents/ees-code-reviewer.md)" 'model: grok-4.7-high' || return 1
  [[ ! -e "$(settings_file "$d")" ]] || { echo "build-agents created a settings.json"; return 1; }
}

c_codex_model_override() { # [A-codex] [A-settings]
  local d; d="$(new_fx codex-override)"
  write_settings "$d" <<'JSON'
{ "agents": { "ees-code-reviewer": { "codex": { "model": "gpt-6.2-terra" } } } }
JSON
  cp "$(settings_file "$d")" "$d/settings.before"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  local f; f="$(codex_reviewer "$d")"
  has_line "$f" 'model = "gpt-6.2-terra"' || return 1
  lacks_line "$f" 'model = "gpt-6.1-terra"' || return 1
  has_line "$f" 'model_reasoning_effort = "high"' || return 1   # effort stays the pack default
  # Nothing else moves: the same agent on other providers and the other agent keep their defaults.
  has_line "$(gen "$d" claude/agents/ees-code-reviewer.md)" 'model: opus' || return 1
  has_line "$(gen "$d" opencode/agents/ees-code-reviewer.md)" 'model: claude-agent/sonnet' || return 1
  has_line "$(gen "$d" codex/agents/ees-implementer.toml)" 'model = "gpt-6.1-terra"' || return 1
  has_line "$(gen "$d" codex/agents/ees-implementer.toml)" 'model_reasoning_effort = "medium"' || return 1
  cmp -s "$d/settings.before" "$(settings_file "$d")" || { echo "build-agents modified settings.json"; return 1; }
}

c_effort_and_variant_override() { # [A-settings]
  local d; d="$(new_fx effort-override)"
  write_settings "$d" <<'JSON'
{
  "agents": {
    "ees-code-reviewer": { "claude": { "effort": "max" } },
    "ees-implementer": { "opencode": { "variant": "medium" } }
  }
}
JSON
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  has_line "$(gen "$d" claude/agents/ees-code-reviewer.md)" 'effort: max' || return 1
  has_line "$(gen "$d" claude/agents/ees-code-reviewer.md)" 'model: opus' || return 1
  has_line "$(gen "$d" opencode/agents/ees-implementer.md)" 'variant: medium' || return 1
  has_line "$(gen "$d" opencode/agents/ees-implementer.md)" 'model: opencode-go/deepseek-v4.1-flash' || return 1
  has_line "$(gen "$d" pi/agents/ees-implementer.md)" 'model: opencode-go/deepseek-v4.1-flash:high' || return 1
}

c_new_default_reaches_unchanged_agents() { # [A-default]
  local d; d="$(new_fx new-default)"
  write_settings "$d" <<'JSON'
{ "agents": { "ees-code-reviewer": { "codex": { "model": "gpt-6.2-terra" } } } }
JSON
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  has_line "$(codex_reviewer "$d")" 'model = "gpt-6.2-terra"' || return 1
  has_line "$(gen "$d" codex/agents/ees-implementer.toml)" 'model = "gpt-6.1-terra"' || return 1
  # A new pack version: the defaults of both agents move to gpt-6-luna.
  edit "$d/tree/agents.toml" 's/model = "gpt-6.1-terra"/model = "gpt-6-luna"/'
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  has_line "$(gen "$d" codex/agents/ees-implementer.toml)" 'model = "gpt-6-luna"' || return 1   # no override: new default
  has_line "$(codex_reviewer "$d")" 'model = "gpt-6.2-terra"' || return 1                       # override persists
  has_line "$(codex_reviewer "$d")" 'model_reasoning_effort = "high"' || return 1
}

c_override_removed_returns_default() { # [A-settings] reset: a settings.json without the key builds the default
  local d; d="$(new_fx reset)"
  write_settings "$d" <<'JSON'
{ "agents": { "ees-code-reviewer": { "codex": { "model": "gpt-6.2-terra" } } } }
JSON
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  has_line "$(codex_reviewer "$d")" 'model = "gpt-6.2-terra"' || return 1
  echo '{}' | write_settings "$d"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  has_line "$(codex_reviewer "$d")" 'model = "gpt-6.1-terra"' || return 1
  lacks_line "$(codex_reviewer "$d")" 'model = "gpt-6.2-terra"' || return 1
}

c_override_outside_catalog_warns_and_applies() { # [A-catalog]
  local d; d="$(new_fx outside-catalog)"
  write_settings "$d" <<'JSON'
{ "agents": { "ees-code-reviewer": { "codex": { "model": "gpt-5-gone" } } } }
JSON
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  warned "$d" ees-code-reviewer gpt-5-gone || return 1
  has_line "$(codex_reviewer "$d")" 'model = "gpt-5-gone"' || return 1   # still used
  has_line "$(codex_reviewer "$d")" 'model_reasoning_effort = "high"' || return 1
}

c_effort_outside_catalog_warns_and_applies() { # [A-catalog]
  local d; d="$(new_fx effort-outside-catalog)"
  write_settings "$d" <<'JSON'
{ "agents": { "ees-implementer": { "claude": { "effort": "turbo" } } } }
JSON
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  warned "$d" ees-implementer turbo || return 1
  has_line "$(gen "$d" claude/agents/ees-implementer.md)" 'effort: turbo' || return 1
}

# ---------------------------------------------------------------- area: catalog validation of defaults

c_default_outside_catalog_fails_build() { # [A-catalog]
  local d; d="$(new_fx default-model-missing)"
  edit "$d/tree/agents.toml" 's/gpt-6.1-terra", effort = "high"/gpt-7-ghost", effort = "high"/'
  run "$d" scripts/build-agents
  ran_failed "$d" || return 1
  names "$d" ees-code-reviewer gpt-7-ghost || return 1
}

c_default_outside_catalog_fails_validate() { # [A-catalog] [A-validate]
  local d; d="$(new_fx default-model-missing-validate)"
  edit "$d/tree/agents.toml" 's/gpt-6.1-terra", effort = "high"/gpt-7-ghost", effort = "high"/'
  run "$d" scripts/build-agents --validate
  ran_failed "$d" || return 1
  names "$d" ees-code-reviewer gpt-7-ghost || return 1
  [[ ! -e "$d/tree/generated" ]] || { echo "--validate wrote generated/"; return 1; }
}

c_default_effort_outside_catalog_fails_validate() { # [A-catalog]
  local d; d="$(new_fx default-effort-missing)"
  edit "$d/tree/agents.toml" 's/effort = "high" }$/effort = "turbo" }/'
  run "$d" scripts/build-agents --validate
  ran_failed "$d" || return 1
  names "$d" ees-code-reviewer turbo || return 1
}

c_default_variant_outside_catalog_fails_build() { # [A-catalog]
  local d; d="$(new_fx default-variant-missing)"
  edit "$d/tree/agents.toml" 's/variant = "high" }$/variant = "ultra" }/'
  run "$d" scripts/build-agents
  ran_failed "$d" || return 1
  names "$d" ees-code-reviewer ultra || return 1
}

# ---------------------------------------------------------------- area: --validate and the removed --check

c_validate_writes_nothing_on_fresh_tree() { # [A-validate]
  local d; d="$(new_fx validate-fresh)"
  run "$d" scripts/build-agents --validate
  ran_ok "$d" || return 1
  [[ ! -e "$d/tree/generated" ]] || { echo "--validate created generated/:"; find "$d/tree/generated" -type f; return 1; }
}

c_validate_leaves_existing_output_alone() { # [A-validate]
  local d before after
  d="$(new_fx validate-existing)"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  before="$(gen_hash "$d")"
  [[ -n "$before" ]] || { echo "build wrote no generated/ files"; return 1; }
  # Settings and a stale/extra file that a real build would rewrite or remove.
  write_settings "$d" <<'JSON'
{ "agents": { "ees-code-reviewer": { "codex": { "model": "gpt-6.2-terra" } } } }
JSON
  echo stale >"$d/tree/generated/codex/agents/ees-removed.toml"
  before="$(gen_hash "$d")"
  run "$d" scripts/build-agents --validate
  ran_ok "$d" || return 1
  after="$(gen_hash "$d")"
  [[ "$before" == "$after" ]] || { echo "--validate changed generated/"; diff <(echo "$before") <(echo "$after") || true; return 1; }
}

c_validate_ignores_stale_output_and_settings() { # [A-validate] --validate checks sources, not generated/
  local d; d="$(new_fx validate-sources-only)"
  write_settings "$d" <<'JSON'
{ "agents": { "ees-code-reviewer": { "codex": { "model": "gpt-5-gone" } } } }
JSON
  run "$d" scripts/build-agents --validate
  ran_ok "$d" || return 1   # no generated/ at all is not an error; a deviation outside the catalog is only a build warning
  [[ ! -e "$d/tree/generated" ]] || { echo "--validate created generated/"; return 1; }
}

c_validate_agent_without_settings() { # [A-validate] agents <-> agents.toml
  local d; d="$(new_fx validate-missing-toml)"
  cp "$d/tree/agents/ees-implementer.md" "$d/tree/agents/ees-extra.md"
  edit "$d/tree/agents/ees-extra.md" 's/ees-implementer/ees-extra/g'
  run "$d" scripts/build-agents --validate
  ran_failed "$d" || return 1
  names "$d" ees-extra || return 1
  [[ ! -e "$d/tree/generated" ]] || { echo "--validate wrote generated/"; return 1; }
}

c_validate_settings_without_agent() { # [A-validate] agents <-> agents.toml
  local d; d="$(new_fx validate-missing-md)"
  rm "$d/tree/agents/ees-implementer.md"
  run "$d" scripts/build-agents --validate
  ran_failed "$d" || return 1
  names "$d" ees-implementer || return 1
}

c_check_option_removed() { # [A-validate] --check of build-agents and build-pi-prompts is gone
  local d; d="$(new_fx check-removed)"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  run "$d" scripts/build-agents --check
  ran_failed "$d" || { echo "(build-agents still accepts --check)"; return 1; }
  run "$d" scripts/build-pi-prompts
  ran_ok "$d" || return 1
  run "$d" scripts/build-pi-prompts --check
  ran_failed "$d" || { echo "(build-pi-prompts still accepts --check)"; return 1; }
}

c_pi_prompts_still_build() { # build-pi-prompts keeps building without --check
  local d; d="$(new_fx pi-prompts)"
  run "$d" scripts/build-pi-prompts
  ran_ok "$d" || return 1
  [[ -f "$d/tree/generated/pi/prompts/ees-demo.md" ]] || { echo "generated/pi/prompts/ees-demo.md not written"; return 1; }
}

# ---------------------------------------------------------------- area: unknown names in settings.json

baseline_hash() { # checksum of generated/ built without any settings
  local d; d="$(new_fx baseline)"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  gen_hash "$d"
}

# unknown_case <name> <settings JSON> <needle>...: build warns naming every needle and ignores the settings.
unknown_case() {
  local d want got json="$2"
  d="$(new_fx "$1")"; shift 2
  want="$(baseline_hash)" || return 1
  printf '%s\n' "$json" | write_settings "$d"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  warned "$d" "$@" || return 1
  got="$(gen_hash "$d")"
  [[ "$want" == "$got" ]] || { echo "unknown settings changed the generated output:"; diff <(echo "$want") <(echo "$got") || true; return 1; }
}

c_unknown_agent() { # [A-unknown]
  unknown_case unknown-agent '{ "agents": { "ees-ghost-agent": { "codex": { "model": "gpt-6.2-terra" } } } }' ees-ghost-agent
}

c_unknown_provider_for_agent() { # [A-unknown]
  unknown_case unknown-provider '{ "agents": { "ees-code-reviewer": { "nonesuch": { "model": "x" } } } }' ees-code-reviewer nonesuch
}

c_unknown_key() { # [A-unknown] tools is not editable
  unknown_case unknown-key '{ "agents": { "ees-code-reviewer": { "claude": { "tools": ["Bash"] } } } }' ees-code-reviewer tools
}

c_provider_the_agent_does_not_have() { # [A-unknown] ees-implementer has no cursor table in agents.toml
  unknown_case missing-provider-table '{ "agents": { "ees-implementer": { "cursor": { "model": "grok-4.7-low" } } } }' ees-implementer cursor
}

c_unknown_top_level_key() { # [A-unknown]
  unknown_case unknown-top-level '{ "frobnicate": true }' frobnicate
}

c_unknown_provider_in_selection() { # [A-unknown]
  unknown_case unknown-selected-provider '{ "providers": ["claude", "ghostprov"] }' ghostprov
}

# ---------------------------------------------------------------- area: opencode-config

# oc <dir>: run opencode-config against <dir>/xdg/opencode with the settings of the scenario.
oc() {
  run "$1" scripts/opencode-config "$1/xdg/opencode"
}

oc_file() { echo "$1/xdg/opencode/opencode.json"; }

c_opencode_default_without_settings() { # [A-opencode]
  local d; d="$(new_fx oc-default)"
  oc "$d"
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  json_is "$(oc_file "$d")" 'c["agent"]["explore"]["variant"]' '"low"' || return 1
  json_is "$(oc_file "$d")" 'c["model"]' '"claude-agent/opus"' || return 1
}

c_opencode_agent_variant_override() { # [A-opencode]
  local d f; d="$(new_fx oc-variant)"
  write_settings "$d" <<'JSON'
{ "opencode": { "agent": { "explore": { "variant": "medium" } } } }
JSON
  oc "$d"
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  f="$(oc_file "$d")"
  json_is "$f" 'c["agent"]["explore"]["variant"]' '"medium"' || return 1                          # deviation, not the default "low"
  json_is "$f" 'c["agent"]["explore"]["model"]' '"opencode-go/deepseek-v4.1-flash"' || return 1   # model stays the default
  json_is "$f" 'c["agent"]["general"]["variant"]' '"low"' || return 1                              # another agent keeps its default
  json_is "$f" 'c["model"]' '"claude-agent/opus"' || return 1
  json_is "$f" 'c["small_model"]' '"opencode-go/deepseek-v4.1-flash"' || return 1
  [[ -n "$(lines_with "$d/out" '.' agent.explore.variant medium)" ]] \
    || { echo "output does not report agent.explore.variant -> medium:"; cat "$d/out"; return 1; }
}

c_opencode_session_model_override() { # [A-opencode]
  local d f; d="$(new_fx oc-model)"
  write_settings "$d" <<'JSON'
{ "opencode": { "model": "claude-agent/sonnet" } }
JSON
  oc "$d"
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  f="$(oc_file "$d")"
  json_is "$f" 'c["model"]' '"claude-agent/sonnet"' || return 1
  json_is "$f" 'c["small_model"]' '"opencode-go/deepseek-v4.1-flash"' || return 1
  json_is "$f" 'c["agent"]["explore"]["variant"]' '"low"' || return 1
}

c_opencode_override_outside_catalog_warns_and_applies() { # [A-catalog] [A-opencode]
  local d; d="$(new_fx oc-outside-catalog)"
  write_settings "$d" <<'JSON'
{ "opencode": { "agent": { "explore": { "variant": "ultra" } } } }
JSON
  oc "$d"
  ran_ok "$d" || return 1
  warned "$d" explore ultra || return 1
  json_is "$(oc_file "$d")" 'c["agent"]["explore"]["variant"]' '"ultra"' || return 1
}

c_opencode_unknown_agent_ignored() { # [A-unknown] [A-opencode]
  local d; d="$(new_fx oc-unknown)"
  write_settings "$d" <<'JSON'
{ "opencode": { "agent": { "ghost-agent": { "variant": "medium" } }, "frobnicate": 1 } }
JSON
  oc "$d"
  ran_ok "$d" || return 1
  warned "$d" ghost-agent || return 1
  warned "$d" frobnicate || return 1
  json_is "$(oc_file "$d")" 'c["agent"]["ghost-agent"]' 'MISSING' || return 1
  json_is "$(oc_file "$d")" 'c["agent"]["explore"]["variant"]' '"low"' || return 1
}

c_opencode_override_keeps_user_config() { # [A-opencode] the merge still preserves keys the pack does not own
  local d; d="$(new_fx oc-keeps)"
  mkdir -p "$d/xdg/opencode"
  echo '{ "theme": "dark", "agent": { "explore": { "temperature": 0.2 } } }' >"$(oc_file "$d")"
  write_settings "$d" <<'JSON'
{ "opencode": { "agent": { "explore": { "variant": "medium" } } } }
JSON
  oc "$d"
  ran_ok "$d" || return 1
  json_is "$(oc_file "$d")" 'c["theme"]' '"dark"' || return 1
  json_is "$(oc_file "$d")" 'c["agent"]["explore"]["temperature"]' '0.2' || return 1
  json_is "$(oc_file "$d")" 'c["agent"]["explore"]["variant"]' '"medium"' || return 1
}

# ---------------------------------------------------------------- area: the real pack

# real_tree: a sandboxed copy of the whole pack with generated/ removed, as after a clean clone; prints the dir.
real_tree() {
  counter=$((counter + 1))
  local d="$sb/$counter-real"
  mkdir -p "$d"/{tree,home,xdg,claude,codex}
  tar --exclude=./.git -cf - . | tar -xf - -C "$d/tree"
  rm -rf "$d/tree/generated"
  echo "$d"
}

c_real_catalog_covers_every_provider() { # [real]
  [[ -f config/models.toml ]] || { echo "config/models.toml does not exist"; return 1; }
  python3 -I - <<'PY'
import sys, tomllib
cat = tomllib.load(open("config/models.toml", "rb"))
need = {"claude": "efforts", "codex": "efforts", "cursor": None, "opencode": "variants", "pi": "variants"}
bad = []
for provider, extra in need.items():
    table = cat.get(provider)
    if not isinstance(table, dict):
        bad.append(f"[{provider}] missing")
        continue
    for key in ("models", extra):
        if key and not (isinstance(table.get(key), list) and table[key] and all(isinstance(v, str) for v in table[key])):
            bad.append(f"[{provider}].{key} is not a non-empty list of strings")
if bad:
    sys.exit("\n".join(bad))
PY
}

c_real_validate_passes_on_clean_clone() { # [real] [A-validate]
  local d; d="$(real_tree)"
  run "$d" scripts/build-agents --validate
  ran_ok "$d" || return 1
  [[ ! -e "$d/tree/generated" ]] || { echo "--validate wrote generated/"; return 1; }
}

c_real_build_is_clean_and_complete() { # [real]
  local d f; d="$(real_tree)"
  run "$d" scripts/build-agents
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  for f in claude/agents/ees-code-reviewer.md codex/agents/ees-code-reviewer.toml cursor/agents/ees-code-reviewer.md \
    opencode/agents/ees-code-reviewer.md pi/agents/ees-code-reviewer.md; do
    [[ -f "$d/tree/generated/$f" ]] || { echo "generated/$f missing"; return 1; }
  done
  has_line "$d/tree/generated/codex/agents/ees-code-reviewer.toml" 'model = "gpt-6.1-terra"' || return 1
  run "$d" scripts/build-pi-prompts
  ran_ok "$d" || return 1
}

c_real_opencode_config_has_no_catalog_warnings() { # [real]
  local d; d="$(real_tree)"
  oc "$d"
  ran_ok "$d" || return 1
  did_not_warn "$d" || return 1
  json_is "$(oc_file "$d")" 'c["model"]' "$(json_get config/opencode.json 'c["model"]')" || return 1
}

